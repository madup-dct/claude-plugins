# Central operator-only example. This boundary is populated centrally and never
# by an employee or plugin user.
MIM_OPERATOR_EMAIL=<set-private-operator-email>
MIM_PROJECT_ID=<set-private-project-id>
MIM_ORGANIZATION_ID=<set-private-organization-id>
MIM_BILLING_ACCOUNT_ID=<set-private-billing-account-id>
